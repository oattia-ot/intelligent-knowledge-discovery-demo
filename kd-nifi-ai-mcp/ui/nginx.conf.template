server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Same-origin API: browser on :27120 talks to this server, which
    # forwards to the orchestrator container. Avoids localhost:27110
    # fetches from a remote client.
    location ~ ^/(chat|health|settings|lookup|nifi|flows|mcp|api) {
        proxy_pass ${ORCHESTRATOR_INTERNAL_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
