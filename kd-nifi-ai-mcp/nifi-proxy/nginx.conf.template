map $http_host $nifi_http_host {
    default                  $host;
    ~*^nifi-proxy(:[0-9]+)?$ localhost;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Internal HTTP for orchestrator / MCP: http://nifi-proxy:8080/nifi-api
server {
    listen 8080;
    server_name _;
    absolute_redirect off;
include /etc/nginx/nifi-proxy-locations.conf;
}

# Public HTTPS canvas: https://HOST:27111/nifi
server {
    listen 8443 ssl;
    server_name _;
    absolute_redirect off;
    ssl_certificate     ${NIFI_PROXY_CERT};
    ssl_certificate_key ${NIFI_PROXY_KEY};
    ssl_session_cache   shared:SSL:10m;
    ssl_protocols       TLSv1.2 TLSv1.3;

include /etc/nginx/nifi-proxy-locations.conf;
}
