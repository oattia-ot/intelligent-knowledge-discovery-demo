# Centralized version / NAR configuration. Do not scatter these values in code.
IDOL_VERSION=26.3
NIFI_VERSION=26.3
IDOL_NAR_VERSION=26.3.0-nifi2
IDOL_NAR_PATH=./nars
IDOL_NAR_REPOSITORY=./nars
NAR_VALIDATION_ENABLED=true
NIFI_DEPLOYMENT_MODE=external
NIFI_IMAGE=microfocusidolserver/nifi-ver2-full:26.3
NIFI_EXTENSIONS_DIR=

NIFI_USERNAME=admin
# Required. Do not use OpenText2026!.
NIFI_PASSWORD=
NIFI_VERIFY_SSL=false
GATEWAY_ENFORCE=true
GATEWAY_API_TOKEN=
GATEWAY_SHARED_SECRET=
GATEWAY_HOST_PORT=27100
GATEWAY_PUBLIC_URL=http://localhost:27100
ANSWER_SERVER_URL=http://answerserver:12000
ANSWER_SYSTEM_NAME=MyAnswerSystem
# Use the Ollama service from idol-docker-setup. Do not start create-ollama.
OLLAMA_BASE_URL=http://ollama:11434
IDOL_HOST=idol-content
IDOL_PORT=9100
IDOL_LICENSE_HOST=idol-licenseserver
IDOL_LICENSE_PORT=20000
IDOL_TLS_ENABLED=false
IDOL_SSL_AUTHORITY_CERTS=
KD_VERSION=26.3
KD_HOST=idol-content
KD_PROTOCOL=http
KD_VERIFY_TLS=false
KD_TIMEOUT_SECONDS=30
KD_CONTENT_PORT=9100
KD_MEDIA_PORT=14000
KD_EDUCTION_PORT=13200
KD_COMMUNITY_PORT=9030
KD_CATEGORY_PORT=9020
KD_DAH_PORT=9060
KD_DIH_PORT=9070
KD_QMS_PORT=16000
KD_CFS_PORT=7000
KD_LICENSE_PORT=20000
# Never put IDOL passwords into flow templates. Use NiFi sensitive parameters.
