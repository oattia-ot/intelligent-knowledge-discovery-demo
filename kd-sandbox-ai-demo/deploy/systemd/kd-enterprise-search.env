# KD Enterprise Search — environment for systemd
# Copy to /etc/default/kd-enterprise-search and adjust paths.

# Absolute path to the Angular app (directory that contains serve.sh)
APP_DIR=/opt/TAX_GOV_AE/apps/web

# Node binary directory (nvm example: /home/ubuntu/.nvm/versions/node/v22.14.0/bin)
# Leave empty to use system node on PATH.
NODE_BIN_DIR=

# Optional: force a specific node binary
# NODE_BIN=/usr/bin/node

# Port / host (serve.sh currently hardcodes 0.0.0.0:4200; keep for documentation)
PORT=4200
HOST=0.0.0.0

# Keep the hosted demo from full-reloading when config JSON is written.
# Set to 1 only on a developer workstation that wants Angular HMR.
KD_LIVE_RELOAD=0
